# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Logging
# Produccion recomendada: info
# Desarrollo recomendado: debug
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# JWT
# Generate with: npm run generate:jwt-secret
JWT_SECRET=replace_with_output_of_npm_run_generate_jwt_secret_64_chars_minimum
JWT_EXPIRES_IN=7d

# OAuth - Google
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# OAuth - Microsoft
MICROSOFT_CLIENT_ID=replace_with_microsoft_client_id
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=replace_with_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Email / SMTP
EMAIL_ENABLED=false
EMAIL_FROM_NAME=Econnet
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=replace_with_mercadopago_access_token
MERCADOPAGO_BACKEND_URL=http://localhost:3000

# Transbank / Webpay / Oneclick
WEBPAY_RETURN_URL=http://localhost:3000/api/pagos/webpay/retorno
ONECLICK_RETURN_URL=http://localhost:3000/api/medios-pago/oneclick/retorno
TRANSBANK_ONECLICK_CHILD_COMMERCE_CODE=replace_with_oneclick_child_commerce_code

# Blue Express / dispatch origin
BLUE_EXPRESS_MODO=mock
BLUE_EXPRESS_API_URL=https://api.example.com
BLUE_EXPRESS_API_KEY=replace_with_blue_express_api_key
BLUE_EXPRESS_CREAR_ENVIO_PATH=/envios
ECONNET_ORIGEN_NOMBRE=Econnet
ECONNET_ORIGEN_DIRECCION=replace_with_origin_address
ECONNET_ORIGEN_COMUNA=Santiago
ECONNET_ORIGEN_REGION=Region Metropolitana

# Background jobs
PEDIDOS_VENCIDOS_ENABLED=false
PEDIDOS_VENCIDOS_INTERVALO_MINUTOS=5
