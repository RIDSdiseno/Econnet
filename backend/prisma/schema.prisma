generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String
  slug        String   @unique
  descripcion String?
  activo      Boolean  @default(true)

  imagenUrl   String?
  publicId    String?
  mostrarHome Boolean @default(true)
  ordenHome   Int     @default(0)

  productos Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categorias")
}

model Marca {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  logoUrl     String?
  activo      Boolean @default(true)
  mostrarHome Boolean @default(false)
  grupo       String  @default("otras")
  orden       Int     @default(0)

  productos Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("marcas")
}
model Producto {
  id Int @id @default(autoincrement())

  nombre      String
  slug        String  @unique
  descripcion String?
  precio      Int
  stock       Int     @default(0)
  sku         String? @unique
  modelo      String?
  garantia    String?
  activo      Boolean @default(true)
  destacado   Boolean @default(false)

  enOferta               Boolean @default(false)
  precioNormal           Int?
  descuento              Int     @default(0)
  etiquetaOferta         String?
  etiquetaEnvio          String?
  etiquetaDisponibilidad String?

  mostrarEnOfertas Boolean @default(false)
  formatoOferta    String  @default("small")
  ordenOferta      Int     @default(0)

  categoriaId Int
  marcaId     Int?

  categoria Categoria @relation(fields: [categoriaId], references: [id])
  marca     Marca?    @relation(fields: [marcaId], references: [id], onDelete: SetNull)

  imagenes         ProductoImagen[]
  especificaciones EspecificacionProducto[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  favoritos    Favorito[]
  carritoItems CarritoItem[]
  pedidoItems  PedidoItem[]

  @@map("productos")
}

model ProductoImagen {
  id         Int @id @default(autoincrement())
  productoId Int

  url         String
  publicId    String?
  esPrincipal Boolean @default(false)
  orden       Int     @default(0)
  tipo        String  @default("galeria")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("producto_imagenes")
}

model EspecificacionProducto {
  id         Int @id @default(autoincrement())
  productoId Int

  nombre String
  valor  String
  orden  Int    @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("producto_especificaciones")
}

model Anuncio {
  id Int @id @default(autoincrement())

  titulo    String?
  subtitulo String?

  imagenUrl String
  publicId  String?

  enlace    String
  ubicacion String @default("promo_horizontal")

  activo Boolean @default(true)
  orden  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("anuncios")
}

model Usuario {
  id Int @id @default(autoincrement())

  nombre       String
  email        String  @unique
  passwordHash String
  telefono     String?
  rut          String? @unique

  aceptaTerminos    Boolean @default(false)
  aceptaPromociones Boolean @default(false)
  aceptaPublicidad  Boolean @default(false)

  rol    String  @default("cliente")
  activo Boolean @default(true)

  direcciones Direccion[]
  favoritos   Favorito[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  carritoItems CarritoItem[]
  pedidos      Pedido[]

  @@map("usuarios")
}

model Direccion {
  id        Int @id @default(autoincrement())
  usuarioId Int

  nombre       String?
  direccion    String
  region       String?
  comuna       String
  calle        String?
  numero       String?
  departamento String?
  telefono     String?
  principal    Boolean @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos   Pedido[]

  @@map("direcciones")
}

model Favorito {
  id         Int @id @default(autoincrement())
  usuarioId  Int
  productoId Int

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([usuarioId, productoId])
  @@map("favoritos")
}

model CarritoItem {
  id         Int @id @default(autoincrement())
  usuarioId  Int
  productoId Int
  cantidad   Int @default(1)

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, productoId])
  @@map("carrito_items")
}

model Pedido {
  id          Int  @id @default(autoincrement())
  usuarioId   Int
  direccionId Int?

  numero String @unique
  estado String @default("pendiente")

  tipoEntrega String @default("despacho")
  metodoPago  String @default("transferencia")
  documento   String @default("boleta")

  nombreCliente   String
  emailCliente    String
  telefonoCliente String?

  direccionTexto String?
  region         String?
  comuna         String?

  subtotal  Int
  descuento Int @default(0)
  despacho  Int @default(0)
  total     Int

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  direccion Direccion? @relation(fields: [direccionId], references: [id], onDelete: SetNull)

  items        PedidoItem[]
  seguimientos PedidoSeguimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pedidos")
}

model PedidoItem {
  id         Int @id @default(autoincrement())
  pedidoId   Int
  productoId Int

  nombreProducto String
  marcaProducto  String?
  imagenUrl      String?

  precioUnitario Int
  cantidad       Int
  subtotal       Int

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@map("pedido_items")
}

model TarifaDespacho {
  id     Int    @id @default(autoincrement())
  codigo String @unique
  nombre String
  precio Int

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tarifas_despacho")
}

model PedidoSeguimiento {
  id       Int @id @default(autoincrement())
  pedidoId Int

  estado  String
  titulo  String
  detalle String?

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("pedido_seguimiento")
}
