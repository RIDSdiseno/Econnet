generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  slug        String     @unique
  descripcion String?
  imagenUrl   String?
  activo      Boolean    @default(true)

  productos   Producto[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categorias")
}

model Marca {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  logoUrl     String?
  activo      Boolean  @default(true)
  mostrarHome Boolean  @default(false)
  grupo       String   @default("otras")
  orden       Int      @default(0)

  productos   Producto[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("marcas")
}

model Producto {
  id          Int      @id @default(autoincrement())

  nombre      String
  slug        String   @unique
  descripcion String?
  precio      Int
  stock       Int      @default(0)
  sku         String?  @unique
  modelo      String?
  garantia    String?
  activo      Boolean  @default(true)

  categoriaId Int
  marcaId     Int?

  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  marca       Marca?    @relation(fields: [marcaId], references: [id], onDelete: SetNull)

  imagenes        ProductoImagen[]
  especificaciones EspecificacionProducto[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("productos")
}

model ProductoImagen {
  id          Int      @id @default(autoincrement())
  productoId  Int

  url         String
  publicId    String?
  esPrincipal Boolean  @default(false)
  orden       Int      @default(0)
  tipo        String   @default("galeria")

  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("producto_imagenes")
}

model EspecificacionProducto {
  id         Int      @id @default(autoincrement())
  productoId Int

  nombre     String
  valor      String
  orden      Int      @default(0)

  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("producto_especificaciones")
}
model Anuncio {
  id        Int      @id @default(autoincrement())

  titulo    String?
  subtitulo String?

  imagenUrl String
  publicId  String?

  enlace    String
  ubicacion String   @default("promo_horizontal")

  activo    Boolean  @default(true)
  orden     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("anuncios")
}

model Usuario {
  id                Int      @id @default(autoincrement())

  nombre            String
  email             String   @unique
  passwordHash      String
  telefono          String?
  rut               String?  @unique

  aceptaTerminos    Boolean  @default(false)
  aceptaPromociones Boolean  @default(false)
  aceptaPublicidad  Boolean  @default(false)

  rol               String   @default("cliente")
  activo            Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("usuarios")
}